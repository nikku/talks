    {
      "id": "PSvqn6NqvCZEnvcZKP15-",
      "type": "text",
      "x": -16482.625370549555,
      "y": 14860.505080477851,
      "width": 934.998779296875,
      "height": 275,
      "angle": 0,
      "strokeColor": "#1e1e1e",
      "backgroundColor": "transparent",
      "fillStyle": "solid",
      "strokeWidth": 2,
      "strokeStyle": "solid",
      "roughness": 1,
      "opacity": 100,
      "groupIds": [],
      "frameId": null,
      "index": "c0Hb",
      "roundness": null,
      "seed": 183547382,
      "version": 819,
      "versionNonce": 1259342890,
      "isDeleted": false,
      "boundElements": null,
      "updated": 1781593377708,
      "link": null,
      "locked": false,
      "text": "* I link a form (dmn, BPMN, job worker)\n  => the editor picks up the form data schema\n  => the editor offers me smart auto completion for input/output mappings\n  => the editor validates if required inputs are provided\n\n* I rename a variable in a linked form\n  => the editor indicates the problem in my diagram (\"variable not provided\")\n  => I can fix the issue, using smart assistance tools\n\n* I define an AHSP tool definition and mistype the variable name in the input mapping\n  => editor validates used variables, indicates mis-use",
      "fontSize": 20,
      "fontFamily": 8,
      "textAlign": "left",
      "verticalAlign": "top",
      "containerId": null,
      "originalText": "* I link a form (dmn, BPMN, job worker)\n  => the editor picks up the form data schema\n  => the editor offers me smart auto completion for input/output mappings\n  => the editor validates if required inputs are provided\n\n* I rename a variable in a linked form\n  => the editor indicates the problem in my diagram (\"variable not provided\")\n  => I can fix the issue, using smart assistance tools\n\n* I define an AHSP tool definition and mistype the variable name in the input mapping\n  => editor validates used variables, indicates mis-use",
      "autoResize": true,
      "lineHeight": 1.25
    },
